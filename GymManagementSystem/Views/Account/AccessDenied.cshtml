
@model GymManagementSystem.BLL.ViewModels.Accounts.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied - Fitness Gym</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" />

    <style>
        :root {
            --dark-blue: #1e293b;
            --btn-blue: #0f172a;
            --bg-gradient: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        }

        body {
            background: var(--bg-gradient);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .denied-card {
            background: #ffffff;
            border: none;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
            max-width: 750px;
            width: 100%;
            padding: 3rem;
            position: relative;
            overflow: hidden;
        }

        .text-title {
            color: #1e293b;
            font-weight: 700;
        }

        .text-blue-strong {
            color: #0d6efd;
        }

        .error-code-box {
            background-color: #f1f5f9;
            color: #475569;
            font-family: 'Courier New', Courier, monospace;
            font-weight: 600;
            padding: 10px 16px;
            border-radius: 6px;
            display: inline-block;
        }

        .btn-return {
            background-color: var(--btn-blue);
            color: #ffffff;
            font-weight: 600;
            padding: 12px 0;
            border-radius: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: block;
            width: 250px;
        }

            .btn-return:hover {
                background-color: #334155;
                color: #ffffff;
            }

        .lock-container {
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>

    <div class="container d-flex justify-content-center">
        <div class="denied-card">
            <div class="row align-items-center">
                <div class="col-md-8 text-start">
                    <div class="mb-4">
                        <i class="bi bi-slash-circle text-danger" style="font-size: 3.5rem;"></i>
                    </div>

                    <h1 class="text-title display-5 mb-4">Access <span class="text-blue-strong">Denied</span></h1>

                    <p class="text-muted leading-relaxed mb-4" style="font-size: 1.05rem;">
                        We're sorry, but you don't have permission to access this resource. Your current user role or membership status doesn't grant you access to this section.
                    </p>

                    <div class="mb-4">
                        <div class="error-code-box">
                            Error Code: 403 - Forbidden Access
                        </div>
                    </div>

                    <p class="text-muted small mb-5">
                        If you believe this is an error or need elevated permissions, please contact the system administrator or your membership manager for assistance.
                    </p>

                    <a href="@Url.Action("Index", "Home")" class="btn-return text-center">
                        Return to Home
                    </a>
                </div>

                <div class="col-md-4 lock-container mt-4 mt-md-0">
                    <i class="bi bi-lock-fill text-warning opacity-75 d-none d-md-block" style="font-size: 9rem; filter: drop-shadow(0px 10px 15px rgba(234, 179, 8, 0.2));"></i>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>